---
---
<section id="countdown" class="countdown-section">
    <div class="celebration" id="celebration" aria-hidden="true"></div>
    <div class="container text-center">
        <h3 class="countdown-title animate-on-scroll fade-up" id="countdown-title">Faltan...</h3>
        <p class="countdown-subtitle" id="countdown-subtitle" hidden></p>
        <div class="countdown-timer">
            <div class="countdown-item animate-on-scroll scale-in delay-1">
                <span class="countdown-number" id="days">0</span>
                <span class="countdown-label">Días</span>
            </div>
            <span class="countdown-separator">:</span>
            <div class="countdown-item animate-on-scroll scale-in delay-2">
                <span class="countdown-number" id="hours">0</span>
                <span class="countdown-label">Horas</span>
            </div>
            <span class="countdown-separator">:</span>
            <div class="countdown-item animate-on-scroll scale-in delay-3">
                <span class="countdown-number" id="minutes">0</span>
                <span class="countdown-label">Minutos</span>
            </div>
            <span class="countdown-separator">:</span>
            <div class="countdown-item animate-on-scroll scale-in delay-4">
                <span class="countdown-number" id="seconds">0</span>
                <span class="countdown-label">Segundos</span>
            </div>
        </div>
    </div>
</section>

<script>
    const weddingDate = new Date('2026-11-28T17:00:00').getTime();
    const countdownElements = {
        days: document.getElementById("days"),
        hours: document.getElementById("hours"),
        minutes: document.getElementById("minutes"),
        seconds: document.getElementById("seconds"),
    };

    const section = document.getElementById("countdown");
    const titleEl = document.getElementById("countdown-title");
    const subtitleEl = document.getElementById("countdown-subtitle");
    const celebrationEl = document.getElementById("celebration");

    const DAY = 1000 * 60 * 60 * 24;
    const weddingDay = new Date(weddingDate);
    weddingDay.setHours(23, 59, 59, 999);
    const weddingDayEnd = weddingDay.getTime();

    type Phase = "normal" | "soon" | "today" | "after";
    let currentPhase: Phase | null = null;
    let celebrationKind: "confetti" | "hearts" | null = null;

    const startOfDay = (t: number) => new Date(new Date(t).setHours(0, 0, 0, 0)).getTime();
    const daysLeft = (now: number) => Math.round((startOfDay(weddingDate) - startOfDay(now)) / DAY);

    function getPhase(now: number): Phase {
        if (now > weddingDayEnd) return "after";
        const days = daysLeft(now);
        if (days <= 0) return "today";
        if (days <= 3) return "soon";
        return "normal";
    }

    function spawnCelebration(kind: "confetti" | "hearts") {
        if (!celebrationEl || celebrationKind === kind) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        celebrationKind = kind;
        celebrationEl.innerHTML = "";
        const colors = ["#C9A96E", "#E8D5B7", "#7AB8F5", "#ffffff"];
        const count = window.innerWidth < 600 ? 18 : 28;
        for (let i = 0; i < count; i++) {
            const p = document.createElement("span");
            const rnd = Math.random;
            p.style.setProperty("--x", `${rnd() * 100}%`);
            p.style.setProperty("--size", `${6 + rnd() * 6}px`);
            p.style.setProperty("--c", kind === "hearts" ? (rnd() > 0.5 ? "#E8D5B7" : "#C9A96E") : colors[i % colors.length]);
            p.style.setProperty("--dur", `${5 + rnd() * 5}s`);
            p.style.setProperty("--delay", `${-rnd() * 8}s`);
            p.style.setProperty("--fall", `${(section?.offsetHeight ?? 400) * 1.1}px`);
            if (kind === "hearts") {
                p.className = "heart";
                p.textContent = "♥";
            }
            celebrationEl.appendChild(p);
        }
    }

    function applyPhase(phase: Phase) {
        if (!section) return;
        section.dataset.phase = phase;

        if (phase === currentPhase && phase !== "soon" && phase !== "today") return;

        if (titleEl && subtitleEl) {
            if (phase === "after") {
                titleEl.textContent = "¡Ya se celebró la boda!";
                subtitleEl.textContent = "28/11/2026 · ¡Felicidades Manuel y Andrea!";
                subtitleEl.hidden = false;
            } else if (phase === "today") {
                const started = Date.now() >= weddingDate;
                titleEl.textContent = started ? "¡Hoy es el gran día!" : "Faltan...";
                subtitleEl.textContent = started ? "¡Felicidades Manuel y Andrea!" : "¡Hoy es el gran día!";
                subtitleEl.hidden = false;
            } else if (phase === "soon") {
                const days = daysLeft(Date.now());
                titleEl.textContent = "Faltan...";
                subtitleEl.textContent = days <= 1 ? "¡Mañana es el gran día!" : `¡Solo ${days} días para el gran día!`;
                subtitleEl.hidden = false;
            } else {
                titleEl.textContent = "Faltan...";
                subtitleEl.hidden = true;
            }
        }

        if (phase === "after") spawnCelebration("hearts");
        else if (phase === "soon" || phase === "today") spawnCelebration("confetti");
        currentPhase = phase;
    }

    function updateCountdown() {
        const now = Date.now();
        const distance = weddingDate - now;

        applyPhase(getPhase(now));

        if (distance < 0) {
            Object.values(countdownElements).forEach((el) => { if (el) el.textContent = "00"; });
            return;
        }

        const days = Math.floor(distance / (1000 * 60 * 60 * 24));
        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        const pad = (n: number) => String(n).padStart(2, "0");
        if (countdownElements.days) countdownElements.days.textContent = pad(days);
        if (countdownElements.hours) countdownElements.hours.textContent = pad(hours);
        if (countdownElements.minutes) countdownElements.minutes.textContent = pad(minutes);
        if (countdownElements.seconds) countdownElements.seconds.textContent = pad(seconds);
    }

    const interval = setInterval(updateCountdown, 1000);
    updateCountdown();
    document.addEventListener("astro:before-swap", () => clearInterval(interval), { once: true });
</script>
