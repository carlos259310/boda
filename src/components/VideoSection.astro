---
---
<section class="video-section">
    <div class="container text-center">
        <h3 class="video-title animate-on-scroll fade-up">Nuestro Video</h3>

        <div class="video-wrapper animate-on-scroll scale-in delay-1">
            <video
                id="bodaVideo"
                class="boda-video"
                src="/vide_boda_2.mp4"
                preload="metadata"
                playsinline
                aria-label="Video de nuestra boda"
            ></video>

            <button class="video-overlay" id="videoPlayBtn" aria-label="Reproducir video">
                <div class="play-circle">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M8 5v14l11-7z"/>
                    </svg>
                </div>
                <p class="overlay-names">Manuel &amp; Andrea</p>
            </button>
        </div>
    </div>
</section>

<style>
    .video-wrapper {
        position: relative;
        max-width: 900px;
        margin: 2rem auto 0;
        border-radius: 24px;
        overflow: hidden;
        aspect-ratio: 16 / 9;
        background: linear-gradient(135deg, #1a3a5c 0%, #2E5C8A 100%);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2), 0 0 0 1px rgba(255, 255, 255, 0.06);
    }

    .boda-video {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }

    .video-overlay {
        position: absolute;
        inset: 0;
        width: 100%;
        border: none;
        background: linear-gradient(
            160deg,
            rgba(26, 58, 92, 0.45) 0%,
            rgba(46, 92, 138, 0.55) 100%
        );
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        cursor: pointer;
        transition: opacity 0.5s ease, backdrop-filter 0.5s ease;
        z-index: 2;
    }

    .video-overlay.hidden {
        opacity: 0;
        pointer-events: none;
        backdrop-filter: blur(0px);
        -webkit-backdrop-filter: blur(0px);
    }

    .play-circle {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 2px solid rgba(255, 255, 255, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    }

    .play-circle svg {
        width: 34px;
        height: 34px;
        color: white;
        margin-left: 4px;
    }

    .video-overlay:hover .play-circle {
        background: rgba(255, 255, 255, 0.28);
        border-color: rgba(255, 255, 255, 0.65);
        transform: scale(1.1);
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
    }

    .overlay-names {
        font-family: var(--font-script);
        font-size: 2.2rem;
        font-weight: 400;
        color: rgba(255, 255, 255, 0.92);
        margin: 0;
        filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.4));
        letter-spacing: 0.03em;
    }

    @media (max-width: 768px) {
        .video-wrapper {
            border-radius: 16px;
            margin-top: 1.5rem;
        }
        .play-circle {
            width: 70px;
            height: 70px;
        }
        .play-circle svg {
            width: 26px;
            height: 26px;
        }
        .overlay-names {
            font-size: 1.7rem;
        }
    }

    @media (max-width: 480px) {
        .play-circle {
            width: 58px;
            height: 58px;
        }
        .overlay-names {
            font-size: 1.4rem;
        }
    }
</style>

<script>
    const video = document.getElementById('bodaVideo') as HTMLVideoElement | null;
    const overlay = document.getElementById('videoPlayBtn') as HTMLButtonElement | null;

    function showOverlay() {
        video?.removeAttribute('controls');
        overlay?.classList.remove('hidden');
    }

    function hideOverlay() {
        overlay?.classList.add('hidden');
        video?.setAttribute('controls', '');
    }

    overlay?.addEventListener('click', () => {
        hideOverlay();
        video?.play();
    });

    video?.addEventListener('play', hideOverlay);
    video?.addEventListener('pause', () => {
        if (video.currentTime > 0 && video.currentTime < video.duration) {
            showOverlay();
        }
    });
    video?.addEventListener('ended', showOverlay);
</script>
