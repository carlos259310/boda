---
import { getImage } from "astro:assets";
import boda1 from "../assets/images/boda_1.jpeg";
import boda2 from "../assets/images/boda_2.jpeg";
import boda3 from "../assets/images/boda_3.jpeg";
import boda4 from "../assets/images/boda_4.jpeg";
import boda5 from "../assets/images/boda_5.jpeg";
import boda6 from "../assets/images/boda_6.jpeg";
import boda7 from "../assets/images/boda_7.jpeg";
import boda8 from "../assets/images/boda_8.jpeg";
import boda10 from "../assets/images/boda_10.jpeg";
import boda11 from "../assets/images/boda_11.jpeg";
import boda12 from "../assets/images/boda_12.jpeg";
import boda13 from "../assets/images/boda_13.jpeg";
import boda14 from "../assets/images/boda_14.jpeg";

const rawImages = [
    { src: boda1, alt: 'Manuel y Andrea - Momento 1' },
    { src: boda2, alt: 'Manuel y Andrea - Momento 2' },
    { src: boda3, alt: 'Manuel y Andrea - Momento 3' },
    { src: boda4, alt: 'Manuel y Andrea - Momento 4' },
    { src: boda5, alt: 'Manuel y Andrea - Momento 5' },
    { src: boda6, alt: 'Manuel y Andrea - Momento 6' },
    { src: boda7, alt: 'Manuel y Andrea - Momento 7' },
    { src: boda8, alt: 'Manuel y Andrea - Momento 8' },
    { src: boda10, alt: 'Manuel y Andrea - Momento 10' },
    { src: boda11, alt: 'Manuel y Andrea - Momento 11' },
    { src: boda12, alt: 'Manuel y Andrea - Momento 12' },
    { src: boda13, alt: 'Manuel y Andrea - Momento 13' },
    { src: boda14, alt: 'Manuel y Andrea - Momento 14' },
];

const images = await Promise.all(
    rawImages.map(async (img) => {
        const optimized = await getImage({ src: img.src, format: 'webp', width: 1200, quality: 80 });
        return { ...img, url: optimized.src };
    })
);

const total = images.length;
---
<section id="galeria" class="galeria-section">
    <div class="container text-center">
        <h3 class="galeria-title animate-on-scroll fade-up">Galería</h3>

        <div class="carousel-wrapper animate-on-scroll scale-in delay-1">
            <div class="slider-container" id="gallerySlider">
                {images.map((img, index) => (
                    <div
                        class={`slide ${index === 0 ? 'active' : ''}`}
                        style={`background-image: url('${img.url}');`}
                        aria-label={img.alt}
                        role="img"
                    ></div>
                ))}
            </div>

            <button class="carousel-control prev" id="prevBtn" aria-label="Imagen anterior">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button class="carousel-control next" id="nextBtn" aria-label="Siguiente imagen">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
            </button>

            <div class="slide-counter" id="slideCounter">01 / {String(total).padStart(2, '0')}</div>
        </div>

        <div class="slider-dots animate-on-scroll fade-up delay-2">
            {images.map((_, index) => (
                <button class={`dot ${index === 0 ? 'active' : ''}`} data-index={index} aria-label={`Ir a imagen ${index + 1}`}></button>
            ))}
        </div>
    </div>
</section>

<style>
    .carousel-wrapper {
        position: relative;
        max-width: 820px;
        margin: 0 auto;
        height: 540px;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.18), 0 0 0 1px rgba(255,255,255,0.08);
    }

    .slider-container {
        width: 100%;
        height: 100%;
        position: relative;
    }

    .slide {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        opacity: 0;
        transition: opacity 1s ease-in-out, transform 1.4s ease-out;
        background-size: cover;
        background-position: center;
        transform: scale(1.06);
    }

    .slide.active {
        opacity: 1;
        transform: scale(1);
        z-index: 1;
    }

    .carousel-control {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        width: 48px;
        height: 48px;
        border-radius: 50%;
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        transition: all 0.3s ease;
    }

    .carousel-control:hover {
        background: rgba(255, 255, 255, 0.35);
        border-color: rgba(255, 255, 255, 0.5);
        transform: translateY(-50%) scale(1.1);
    }

    .carousel-control svg {
        width: 22px;
        height: 22px;
    }

    .prev { left: 18px; }
    .next { right: 18px; }

    .slide-counter {
        position: absolute;
        bottom: 18px;
        right: 20px;
        z-index: 10;
        font-family: var(--font-sans);
        font-size: 0.78rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.85);
        letter-spacing: 0.12em;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        padding: 5px 12px;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,0.15);
    }

    .slider-dots {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-top: 24px;
    }

    .dot {
        width: 28px;
        height: 3px;
        border-radius: 3px;
        background: var(--color-primary);
        opacity: 0.25;
        cursor: pointer;
        border: none;
        padding: 0;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .dot.active {
        width: 48px;
        opacity: 1;
        background: var(--color-primary);
        box-shadow: 0 0 12px rgba(74, 144, 226, 0.6);
    }

    .dot:hover:not(.active) {
        opacity: 0.55;
        width: 36px;
    }

    @media (max-width: 768px) {
        .carousel-wrapper {
            height: 360px;
            border-radius: 16px;
        }
        .carousel-control {
            width: 40px;
            height: 40px;
        }
        .carousel-control svg {
            width: 18px;
            height: 18px;
        }
        .dot {
            width: 20px;
        }
        .dot.active {
            width: 36px;
        }
    }

    @media (max-width: 480px) {
        .carousel-wrapper {
            height: 280px;
        }
        .prev { left: 10px; }
        .next { right: 10px; }
    }
</style>

<script>
    let currentIndex = 0;
    const slides = document.querySelectorAll<HTMLElement>(".slide");
    const dots = document.querySelectorAll<HTMLElement>(".dot");
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");
    const counter = document.getElementById("slideCounter");
    const totalSlides = slides.length;
    let autoPlayInterval: ReturnType<typeof setInterval>;

    function updateCarousel(index: number) {
        slides.forEach((slide, i) => {
            slide.classList.toggle('active', i === index);
        });
        dots.forEach((dot, i) => {
            dot.classList.toggle('active', i === index);
        });
        if (counter) {
            counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(totalSlides).padStart(2, '0')}`;
        }
        currentIndex = index;
    }

    function nextSlide() {
        updateCarousel((currentIndex + 1) % totalSlides);
    }

    function prevSlide() {
        updateCarousel((currentIndex - 1 + totalSlides) % totalSlides);
    }

    function startAutoPlay() {
        autoPlayInterval = setInterval(nextSlide, 5000);
    }

    function resetAutoPlay() {
        clearInterval(autoPlayInterval);
        startAutoPlay();
    }

    nextBtn?.addEventListener("click", () => { nextSlide(); resetAutoPlay(); });
    prevBtn?.addEventListener("click", () => { prevSlide(); resetAutoPlay(); });

    dots.forEach((dot, index) => {
        dot.addEventListener("click", () => { updateCarousel(index); resetAutoPlay(); });
    });

    startAutoPlay();

    const wrapper = document.querySelector('.carousel-wrapper');
    wrapper?.addEventListener('mouseenter', () => clearInterval(autoPlayInterval));
    wrapper?.addEventListener('mouseleave', startAutoPlay);

    // Touch/swipe — filtra scroll vertical para evitar cambios accidentales
    let touchStartX = 0;
    let touchStartY = 0;
    wrapper?.addEventListener('touchstart', (e) => {
        touchStartX = (e as TouchEvent).changedTouches[0].clientX;
        touchStartY = (e as TouchEvent).changedTouches[0].clientY;
    }, { passive: true });
    wrapper?.addEventListener('touchend', (e) => {
        const deltaX = touchStartX - (e as TouchEvent).changedTouches[0].clientX;
        const deltaY = touchStartY - (e as TouchEvent).changedTouches[0].clientY;
        if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 40) {
            deltaX > 0 ? nextSlide() : prevSlide();
            resetAutoPlay();
        }
    }, { passive: true });
</script>
