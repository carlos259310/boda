---
<nav class="navbar" id="navbar">
    <div class="nav-container">
        <button class="nav-toggle" id="navToggle" aria-label="Abrir menú">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <ul class="nav-menu" id="navMenu">
            <li><a href="#inicio"    class="nav-link">Inicio</a></li>
            <li><a href="#ceremonia" class="nav-link">Ceremonia</a></li>
            <li><a href="#vestuario" class="nav-link">Vestuario</a></li>
            <li><a href="#galeria"   class="nav-link">Galería</a></li>
            <li><a href="#confirmar" class="nav-link">Confirmar</a></li>
        </ul>

        <div class="nav-countdown" id="navCountdown" aria-label="Días para la boda">
            <span class="nav-countdown-number" id="navDays">—</span>
            <span class="nav-countdown-label">días</span>
        </div>
    </div>
</nav>

<style>
    .nav-countdown {
        display: flex;
        flex-direction: column;
        align-items: center;
        line-height: 1;
        padding: 6px 14px;
        border-radius: 20px;
        background: rgba(74, 144, 226, 0.08);
        border: 1px solid rgba(74, 144, 226, 0.18);
        transition: background 0.3s ease;
        white-space: nowrap;
    }

    .navbar.scrolled .nav-countdown {
        background: rgba(74, 144, 226, 0.12);
    }

    .nav-countdown-number {
        font-family: var(--font-serif, "Playfair Display", serif);
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--color-primary-dark, #2E5C8A);
        letter-spacing: -0.02em;
    }

    .nav-countdown-label {
        font-family: var(--font-sans, "Poppins", sans-serif);
        font-size: 0.6rem;
        font-weight: 500;
        color: var(--color-text-light, #6c757d);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    @media (max-width: 768px) {
        .nav-countdown {
            padding: 4px 10px;
        }
        .nav-countdown-number {
            font-size: 0.95rem;
        }
    }
</style>

<script>
    // ── Hamburger & scroll ──────────────────────────────────────────────
    const navToggle = document.getElementById("navToggle");
    const navMenu   = document.getElementById("navMenu");
    const navLinks  = document.querySelectorAll(".nav-link");
    const navbar    = document.getElementById("navbar");

    navToggle?.addEventListener("click", () => {
        navToggle.classList.toggle("active");
        navMenu?.classList.toggle("active");
    });

    navLinks.forEach((link) => {
        link.addEventListener("click", () => {
            navToggle?.classList.remove("active");
            navMenu?.classList.remove("active");
        });
    });

    window.addEventListener("scroll", () => {
        navbar?.classList.toggle("scrolled", window.scrollY > 50);
    }, { passive: true });

    // ── Countdown ──────────────────────────────────────────────────────
    const wedding = new Date("2026-11-28T17:00:00");
    const el = document.getElementById("navDays");

    function updateDays() {
        const diff = Math.ceil((wedding.getTime() - Date.now()) / 86_400_000);
        if (el) el.textContent = diff > 0 ? String(diff) : "¡Hoy!";
    }

    updateDays();
</script>
